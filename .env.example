SECRET_KEY=change-me-to-a-random-string
FLASK_ENV=development
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gemma4:26b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
# 4096 leaves VRAM headroom for the GPU reranker alongside gemma4:26b on a 24 GB
# card; raise toward 8192 if you free GPU memory (smaller model / CPU reranker).
OLLAMA_NUM_CTX=4096
OLLAMA_THINK=false
CHROMA_DB_PATH=data/chroma_db
RAG_TOP_K=6
RAG_TEMPERATURE=0.3
RAG_MAX_PER_SOURCE=2
# Two-stage retrieval: deep candidate pool size, then cross-encoder rerank,
# fused with the first-stage ranking (RAG_RERANK_WEIGHT) to resist entity drift.
RAG_CANDIDATE_K=40
RAG_RERANK_ENABLED=true
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=auto
RAG_RERANK_WEIGHT=0.5
# Preload the reranker at server start (set in the systemd service env).
RAG_RERANK_PRELOAD=true
# Conversational memory: rewrite follow-up questions into standalone search
# queries (one extra LLM call per follow-up) so retrieval keeps the entity, and
# replay recent turns to the chat model. Set RAG_CONTEXTUALIZE=false to keep
# history but skip the rewrite. MAX_TURNS/MAX_CHARS bound what is replayed.
RAG_CONTEXTUALIZE=true
RAG_HISTORY_MAX_TURNS=6
RAG_HISTORY_MAX_CHARS=1200
# Cite a source only if its chunk is BOTH cross-encoder-relevant (>= MIN_RERANK)
# AND a close vector match (<= MAX_DISTANCE), so off-topic answers carry no
# citations and focused answers don't tack on weak or merely-related pages.
RAG_RELEVANCE_MIN_RERANK=0.4
RAG_RELEVANCE_MAX_DISTANCE=0.31
# Rate-limit storage: memory:// for single worker; redis://... when scaling out
RATELIMIT_STORAGE_URI=memory://
